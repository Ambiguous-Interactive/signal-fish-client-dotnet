root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,props,targets,config}]
indent_size = 4

# C# style rules enforced at build time (EnforceCodeStyleInBuild) and by
# `dotnet format`. Ban `var`: every local declares its type explicitly
# (IDE0008). `using` directives live inside the namespace (IDE0065).
# `this.` qualification is banned (IDE0003 family): private fields carry the
# `_camelCase` prefix, so member access never needs disambiguation.
[*.cs]
csharp_style_var_for_built_in_types = false:error
csharp_style_var_when_type_is_apparent = false:error
csharp_style_var_elsewhere = false:error
dotnet_diagnostic.IDE0008.severity = error
csharp_using_directive_placement = inside_namespace:error
dotnet_diagnostic.IDE0065.severity = error
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error
dotnet_style_qualification_for_event = false:error

# Private fields are `_camelCase` (matches the repo naming conventions):
# the underscore prefix is what makes the `this.` ban above safe. Const
# fields stay PascalCase per the repo naming table (first matching rule
# wins).
dotnet_naming_rule.const_fields_pascal.severity = error
dotnet_naming_rule.const_fields_pascal.symbols = const_fields
dotnet_naming_rule.const_fields_pascal.style = const_fields_pascal_case
dotnet_naming_symbols.const_fields.applicable_kinds = field
dotnet_naming_symbols.const_fields.applicable_modifiers = const
dotnet_naming_style.const_fields_pascal_case.capitalization = pascal_case
dotnet_naming_rule.private_fields_underscore_prefix.severity = error
dotnet_naming_rule.private_fields_underscore_prefix.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_prefix.style = private_fields_underscore_camel
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.private_fields_underscore_camel.required_prefix = _
dotnet_naming_style.private_fields_underscore_camel.capitalization = camel_case

# Wire-protocol conventions (scoped to src/SignalFish.Client/Protocol/ so
# other code still gets checked):
# - CA1028 (enums should be Int32): the protocol enums (MessageKind,
#   EnvelopeEventKind, DecodeError, delivery classes, room-op kinds) are
#   deliberately byte-backed: they live inside hot-path structs and ring
#   buffers where cache density is the point (locked zero-alloc budget).
# - CA1815 (override Equals/== on public structs): EnvelopeEvent is a
#   hot-path struct consumed via DrainEvents; it is never compared, so
#   operator/Equals overrides would be dead weight on the allocation-free
#   path.
[src/SignalFish.Client/Protocol/*.cs]
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1815.severity = none

# Polling-client conventions (scoped to src/SignalFish.Client/Polling/):
# - CA1028 (enums should be Int32): PollEventKind is byte-backed so
#   PollEvent stays dense inside the ring buffer (locked zero-alloc budget;
#   same rationale as the Protocol enums).
# - CA1815 (override Equals/== on public structs): PollEvent is a hot-path
#   tag-and-payload union consumed via DrainEvents; it is never compared,
#   so operator/Equals overrides would be dead weight.
[src/SignalFish.Client/Polling/*.cs]
dotnet_diagnostic.CA1028.severity = none
dotnet_diagnostic.CA1815.severity = none

# Bounded-queue naming (scoped to the queue itself): IBoundedQueue and
# BoundedQueue are the PLAN.md-mandated names for the channel-free
# event/command channels (locked zero-dependency decision); CA1711's
# reserve-the-suffix rule does not apply to a hand-rolled type that
# deliberately is not System.Collections.Queue.
[src/SignalFish.Client/Async/BoundedQueue.cs]
dotnet_diagnostic.CA1711.severity = none
[src/SignalFish.Client/Core/IBoundedQueue.cs]
dotnet_diagnostic.CA1711.severity = none

# QueueRead is a boundary envelope (item-or-end-of-stream) that is never
# compared, so Equals/== overrides would be dead weight.
[src/SignalFish.Client/Core/QueueRead.cs]
dotnet_diagnostic.CA1815.severity = none

# Async-client conventions (scoped to src/SignalFish.Client/Async/):
# - CA1031: best-effort teardown paths (send failures, receive faults,
#   disposal) must swallow anything — a dead wire can fault with any
#   exception, and the session folds it into the terminal event. This is
#   the design, mirroring the polling client.
# - CA1859: the event/command queues are held as IBoundedQueue<T> on
#   purpose — the abstraction is the M4.1 swap-in contract (plan: hand-
#   rolled default, alternatives kept behind the interface).
# - CA2213: the queues are IAsyncDisposable but not IDisposable; disposal
#   happens via await in DisposeAsync, which the analyzer's IDisposable
#   dataflow cannot see.
[src/SignalFish.Client/Async/SignalFishClient.cs]
dotnet_diagnostic.CA1031.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA2213.severity = none

[src/SignalFish.Client/Async/BoundedQueue.cs]
dotnet_diagnostic.CA1859.severity = none

# The polling client's ping send and best-effort teardown complete off the
# game thread and must never surface exceptions into an unobserved task
# (the fire-and-forget is the design); failures fold back into the next
# Poll as a liveness teardown.
[src/SignalFish.Client/Polling/SignalFishPollingClient.cs]
dotnet_diagnostic.CA1031.severity = none

# Transport sizing probe is deliberately fail-open: any failure (malformed
# body, proxy interference, exotic socket error) must fall back to the
# protocol default instead of blocking the connect. The catch-all is the
# feature; reaction logic keys on close codes, not on probe exceptions.
[src/SignalFish.Client/Transport/*.cs]
dotnet_diagnostic.CA1031.severity = none

# Tests never marshal back to a captured context (NUnit installs none), so
# ConfigureAwait(false) would be pure noise across every await in the suite.
[tests/**/*.cs]
dotnet_diagnostic.CA2007.severity = none
# Test fixtures construct-and-abandon transports on purpose; disposal under
# stress is asserted explicitly by dedicated tests, not by CA2000 dataflow.
dotnet_diagnostic.CA2000.severity = none
# The loopback test server must survive arbitrary/aborted client behavior
# (half-open sockets, bad handshakes); the catch-all keeps it serving.
dotnet_diagnostic.CA1031.severity = none
# SHA1 here is the RFC 6455 WebSocket accept key derivation, not crypto.
dotnet_diagnostic.CA5350.severity = none

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Perf-tooling conventions (scoped to tests/SignalFish.Client.PerfTests/):
# - CA1711: ChannelsBoundedQueue is the M4.1 spike's comparison arm over
#   System.Threading.Channels; the suffix mirrors the type it benchmarks.
# - CA1001: BenchmarkDotNet owns benchmark-class lifecycle via GlobalSetup/
#   iteration cleanup; the queue fields are intentionally left to it.
[tests/SignalFish.Client.PerfTests/BoundedQueueBenchmarks.cs]
dotnet_diagnostic.CA1711.severity = none
dotnet_diagnostic.CA1001.severity = none
