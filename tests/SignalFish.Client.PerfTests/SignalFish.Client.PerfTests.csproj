<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <IsPackable>false</IsPackable>
        <!-- Benchmarks are run explicitly (dotnet run -c Release); they are
             never part of `dotnet test`. The library itself stays zero-dependency;
             BenchmarkDotNet lives only in this tooling project. -->
        <NoWarn>$(NoWarn);CA1515</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SignalFish.Client\SignalFish.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- Golden protocol fixtures (tests/Golden, vendored by
             scripts/sync-protocol-fixtures.ps1) travel with the output so the
             benchmarks measure the exact corpus the tests pin. -->
        <Content
            Include="..\Golden\**\*.jsonl"
            CopyToOutputDirectory="PreserveNewest"
            LinkBase="Golden\"
        />
    </ItemGroup>
</Project>
