<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="10.1.0" />
        <PackageReference Include="FsCheck.NUnit" Version="3.4.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="NUnit" Version="4.6.1" />
        <PackageReference Include="NUnit.Analyzers" Version="4.15.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="NUnit.Framework" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\SignalFish.Client\SignalFish.Client.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The shared adapter core (unity/Adapters/Core/Runtime) is
             engine- and SDK-free C#, so the dotnet test suite compiles and
             exercises it directly; the contract lint pins the same sources
             against the Unity compile shape and forbids adapter-local
             copies of the shared types. -->
        <Compile Include="..\..\unity\Adapters\Core\Runtime\**\*.cs" LinkBase="Adapters\Core" />
        <!-- The FishNet adapter's own pure core (the host-mode loopback)
             is engine- and FishNet-free C# exercised the same way. -->
        <Compile
            Include="..\..\unity\Adapters\FishNet\Runtime\Core\**\*.cs"
            LinkBase="Adapters\FishNet\Core"
        />
        <!-- The NGO adapter's pure core (the join-code envelope, the
             room roster, the approval payload) is engine- and NGO-free
             C# exercised the same way. -->
        <Compile
            Include="..\..\unity\Adapters\Ngo\Runtime\Core\**\*.cs"
            LinkBase="Adapters\Ngo\Core"
        />
        <!-- The PUN2 adapter's pure core (the room-name envelope) is
             engine- and Photon-free C# exercised the same way. -->
        <Compile
            Include="..\..\unity\Adapters\Pun2\Runtime\Core\**\*.cs"
            LinkBase="Adapters\Pun2\Core"
        />
        <!-- The Fusion adapter's pure core (the session-name envelope)
             is engine- and Fusion-free C# exercised the same way. -->
        <Compile
            Include="..\..\unity\Adapters\Fusion\Runtime\Core\**\*.cs"
            LinkBase="Adapters\Fusion\Core"
        />
        <!-- The Steamworks.NET adapter's pure core (the SteamId64
             identity envelope) is engine- and Steamworks-free C#
             exercised the same way. -->
        <Compile
            Include="..\..\unity\Adapters\SteamworksNet\Runtime\Core\**\*.cs"
            LinkBase="Adapters\SteamworksNet\Core"
        />
        <!-- The Facepunch adapter's pure core (the same SteamId64
             identity envelope, one namespace over) is exercised the
             same way; the two lane keys must stay byte-identical. -->
        <Compile
            Include="..\..\unity\Adapters\Facepunch\Runtime\Core\**\*.cs"
            LinkBase="Adapters\Facepunch\Core"
        />
    </ItemGroup>

    <ItemGroup>
        <!-- Golden protocol fixtures (tests/Golden, vendored by
             scripts/sync-protocol-fixtures.ps1) travel with the test output. -->
        <Content
            Include="..\Golden\**\*.jsonl"
            CopyToOutputDirectory="PreserveNewest"
            LinkBase="Golden\"
        />
        <!-- The msgpack-frame fuzz corpus (owned by the fuzz host project)
             travels with the test output for the corpus-contract test. -->
        <Content
            Include="..\SignalFish.Client.FuzzTests\Corpus\**\*.bin"
            CopyToOutputDirectory="PreserveNewest"
            LinkBase="Corpus\"
        />
    </ItemGroup>
</Project>
