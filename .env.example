# SignalFish devcontainer credentials — template.
# Copy to .env.local (gitignored) and fill in what you use:
#   cp .env.example .env.local
# .env.local wins over .env, which wins over variables inherited from your
# host environment. Aliases are accepted for convenience.

# --- GitHub (powers github MCP server, gh CLI, Copilot CLI auth) ---
# A fine-grained PAT with repo (+ workflow if you need Actions tools) is enough.
# Aliases: GITHUB_PAT, GH_TOKEN, GITHUB_TOKEN, GITHUB_MCP_PAT
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Z.AI / GLM Coding Plan (vision, web search, web reader, zread MCP) ---
# Also powers the claude-zai and codex-zai launchers (see
# .devcontainer/ai-backends.sh). Get a key: https://z.ai/manage-apikey/apikey-list
# Aliases: ZAI_API_KEY, ZHIPU_API_KEY
Z_AI_API_KEY=
# ZAI (z.ai platform, default) or ZHIPU (bigmodel.cn platform)
Z_AI_MODE=ZAI

# --- OpenRouter (claude-openrouter and codex-openrouter launchers) ---
# Get a key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# --- Optional: model provider keys for the CLIs themselves ---
# Codex can instead use `codex login` (ChatGPT plan).
OPENAI_API_KEY=
# Claude Code can instead use `claude` onboarding (subscription login).
ANTHROPIC_API_KEY=
# Optional: raises context7 MCP rate limits (keyless also works).
CONTEXT7_API_KEY=

# --- Optional: devcontainer behavior ---
# always  -> refresh the CLIs on every container start (slower start)
# unset   -> refresh in the background at most once per day (default)
#DEVCONTAINER_CLI_REFRESH=
