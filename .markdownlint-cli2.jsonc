// Configuration for markdownlint-cli2
// See: https://github.com/DavidAnson/markdownlint-cli2#configuration
//
// Rule configuration lives in .markdownlint.json (auto-discovered by
// markdownlint-cli2 when present in the same directory). Mirrors the
// signal-fish-client-rust repo so both clients enforce the same bar.
{
  // Directories to exclude from linting. progress/ holds historical session
  // notes (never rewritten), and PLAN.md is a fast-churning working doc;
  // neither is rendered documentation.
  "ignores": [
    "**/bin/**",
    "**/obj/**",
    "**/TestResults/**",
    "site/**",
    ".git/**",
    ".venv/**",
    "node_modules/**",
    "progress/**",
    "PLAN.md"
  ]
}
