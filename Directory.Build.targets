<Project>
    <!-- Test-assembly conventions NUnit requires: underscore test names are
       the repo's Method_Scenario_Expectation standard (CA1707), [TestCase]
       arguments are framework-provided and non-null (CA1062), and test
       classes must be public for reflection discovery (CA1515). Lives in
       .targets (not .props) because IsTestProject is set in the csproj
       body, which evaluates after Directory.Build.props is imported. -->
    <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
        <NoWarn>$(NoWarn);CA1707;CA1062;CA1515</NoWarn>
    </PropertyGroup>
</Project>
